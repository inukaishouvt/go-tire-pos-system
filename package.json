{
  "name": "pos-system",
  "version": "1.0.0",
  "description": "Point of Sale System with SQLite, Barcode Support, and User Management",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "cd backend && node server.js",
    "client": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "migrate": "node backend/database/migrate.js",
    "start": "npm run migrate && npm run server"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "csv-writer": "^1.6.0",
    "node-cron": "^3.0.2",
    "fs-extra": "^11.1.1",
    "sqlite3": "^5.1.6"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "sqlite",
    "barcode",
    "retail"
  ],
  "author": "POS System Developer",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}